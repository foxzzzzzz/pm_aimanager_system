<view class="page">
  <view class="page-head">
    <text class="muted">仅显示已完成身份绑定的项目</text>
  </view>
  <view wx:if="{{loading}}" class="card loading-state">正在加载项目…</view>
  <view wx:if="{{!loading && loadError}}" class="card error-state">
    <text class="error-title">项目加载失败</text>
    <text class="error-detail">请检查网络连接后重新加载。</text>
    <button class="retry-action" bindtap="loadProjects">重新加载</button>
  </view>
  <view wx:if="{{!loading && !loadError && projects.length === 0}}" class="card empty">暂无已绑定项目，请从邀请链接进入。</view>
  <view wx:if="{{!loading && !loadError}}" wx:for="{{projects}}" wx:key="id" class="card project" data-id="{{item.id}}" data-code="{{item.code}}" data-name="{{item.name}}" bindtap="openProject">
    <text class="tag">{{item.code}}</text>
    <view class="project-title-row"><text class="project-name">{{item.name}}</text><text wx:if="{{item.pending_approval_count > 0}}" class="approval-count">待审批 {{item.pending_approval_count}}</text></view>
    <text class="muted">当前正式版本 v{{item.current_version_number}}</text>
    <view wx:if="{{item.overdueMilestones.length > 0}}" class="alert-section overdue-section">
      <text class="alert-heading overdue-heading">逾期节点 {{item.overdueMilestones.length}}</text>
      <view wx:for="{{item.overdueMilestones}}" wx:key="code" wx:for-item="milestone" class="alert-milestone overdue-milestone">
        <view class="alert-title"><text>{{milestone.code}} · {{milestone.name}}</text><text class="alert-date">截止 {{milestone.endDate}}</text></view>
        <view class="alert-raci">
          <view wx:for="{{milestone.roles}}" wx:key="key" wx:for-item="role" class="raci-role"><text class="raci-key">{{role.key}}</text><text class="raci-names">{{role.names}}</text></view>
        </view>
      </view>
    </view>
    <view wx:if="{{item.upcomingMilestones.length > 0}}" class="alert-section upcoming-section">
      <text class="alert-heading upcoming-heading">近期节点 {{item.upcomingMilestones.length}}</text>
      <view wx:for="{{item.upcomingMilestones}}" wx:key="code" wx:for-item="milestone" class="alert-milestone">
        <view class="alert-title"><text>{{milestone.code}} · {{milestone.name}}</text><text class="alert-date">截止 {{milestone.endDate}}</text></view>
        <view class="alert-raci">
          <view wx:for="{{milestone.roles}}" wx:key="key" wx:for-item="role" class="raci-role"><text class="raci-key">{{role.key}}</text><text class="raci-names">{{role.names}}</text></view>
        </view>
      </view>
    </view>
    <view wx:if="{{item.overdueMilestones.length === 0 && item.upcomingMilestones.length === 0}}" class="alert-empty">未来14天暂无到期或逾期节点</view>
  </view>
</view>
