<view class="page">
  <view class="page-head">
    <text class="title">我的项目</text>
    <text class="muted">仅显示已完成身份绑定的项目</text>
  </view>
  <view wx:if="{{loading}}" class="card loading-state">正在加载项目…</view>
  <view wx:if="{{!loading && projects.length === 0}}" class="card empty">暂无已绑定项目，请从邀请链接进入。</view>
  <view wx:if="{{!loading}}" wx:for="{{projects}}" wx:key="id" class="card project" data-id="{{item.id}}" data-code="{{item.code}}" data-name="{{item.name}}" bindtap="openProject">
    <text class="tag">{{item.code}}</text>
    <text class="project-name">{{item.name}}</text>
    <text class="muted">当前正式版本 v{{item.current_version_number}}</text>
  </view>
</view>
