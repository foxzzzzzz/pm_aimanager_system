.task-filters { display: flex; width: 100%; gap: 10rpx; margin-bottom: 20rpx; }
.task-filter { flex: 1 1 0; width: 0; min-width: 0; box-sizing: border-box; margin: 0; padding: 0 4rpx; border: 1rpx solid #c9ddd8; border-radius: 999rpx; color: #53635f; background: #fff; font-size: 23rpx; line-height: 58rpx; white-space: nowrap; overflow: hidden; }
.task-filter::after { border: 0; }
.task-filter.active { color: #fff; background: #146c5a; }
.task-filter.upcoming { color: #b54708; border-color: #f7cda7; background: #fff8f1; }
.task-filter.overdue { color: #c53030; border-color: #f5b9b6; }
.task-filter.upcoming.active,
.task-filter.overdue.active { color: #fff; background: #c53030; }
.task-filter.upcoming.active { background: #146c5a; }
.project-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding-bottom: 14rpx; }
.project-name { margin-left: 12rpx; font-size: 30rpx; font-weight: 700; }
.project-entry { flex-shrink: 0; color: #087a64; font-size: 23rpx; font-weight: 650; }
.task-row { padding: 18rpx 0; border-top: 1rpx solid #e3ece9; }
.task-main { display: flex; justify-content: space-between; gap: 16rpx; }
.task-title { min-width: 0; font-size: 26rpx; font-weight: 650; }
.task-date { flex-shrink: 0; color: #63716d; font-size: 22rpx; }
.task-role { display: flex; align-items: center; gap: 8rpx; margin-top: 12rpx; color: #63716d; font-size: 22rpx; }
.role-tag { padding: 3rpx 12rpx; border-radius: 999rpx; color: #146c5a; background: #dff2ec; font-weight: 700; }
.task-kind { display: inline-block; margin-top: 10rpx; padding: 3rpx 12rpx; border-radius: 999rpx; color: #b54708; background: #fff1e6; font-size: 21rpx; }
.overdue-task .task-title, .overdue-task .task-date { color: #c53030; }
