.review-summary .muted { display: block; }
.counts { margin-top: 12rpx; }
.tabs { display: flex; gap: 12rpx; margin-bottom: 24rpx; }
.tab {
  flex: 1;
  margin: 0;
  padding: 0;
  border: 1rpx solid #c9ddd8;
  border-radius: 14rpx;
  background: #fff;
  color: #53635f;
  font-size: 25rpx;
  line-height: 70rpx;
}
.tab::after { border: 0; }
.tab.active { background: #146c5a; color: #fff; }
.data-search {
  position: sticky;
  top: 0;
  z-index: 2;
  margin-bottom: 24rpx;
  padding: 14rpx 0;
  background: #edf4f1;
}
.search-row { display: flex; align-items: center; gap: 12rpx; }
.search-input {
  flex: 1;
  padding: 18rpx 22rpx;
  border: 1rpx solid #c9ddd8;
  border-radius: 14rpx;
  background: #fff;
}
.search-clear { flex: none; margin: 0; color: #146c5a; background: #fff; }
.search-result { display: block; margin-top: 10rpx; color: #63716d; font-size: 22rpx; }
.item-title { display: block; font-size: 30rpx; font-weight: 650; }
.detail, .note, .role { display: block; margin-top: 12rpx; }
.detail-content.clamped { max-height: 132rpx; overflow: hidden; }
.detail-toggle { margin: 12rpx 0 0; padding: 0; border-radius: 0; color: #146c5a; background: transparent; font-size: 23rpx; line-height: 52rpx; text-align: left; }
.detail-toggle::after { border: 0; }
.note { color: #63716d; font-size: 24rpx; }
.role { color: #146c5a; }
.milestone-title { display: flex; gap: 14rpx; align-items: center; margin-bottom: 12rpx; }
.code { color: #146c5a; font-weight: 700; }
.raci-row { display: flex; margin-top: 14rpx; }
.raci-key { width: 54rpx; color: #146c5a; font-weight: 700; }
.raci-names { flex: 1; color: #53635f; }
.load-more { margin: 20rpx 0 30rpx; }
.empty-state { color: #6f7b78; text-align: center; }
