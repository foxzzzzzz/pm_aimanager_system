.message-meta { display: flex; align-items: center; justify-content: space-between; }
.unread-state { display: flex; align-items: center; gap: 8rpx; color: #146c5a; font-size: 22rpx; font-weight: 600; }
.unread-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #18b875; }
.message-title { display: block; margin: 16rpx 0 10rpx; font-weight: 650; }
.time { display: block; margin-top: 14rpx; color: #8a9692; font-size: 22rpx; }
.read { opacity: 0.82; }
.config-note { display: block; margin: 14rpx 0 24rpx; color: #8a9692; font-size: 22rpx; text-align: center; }
