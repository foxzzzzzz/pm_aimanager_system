<view class="page" wx:if="{{loading}}">
  <view class="card loading-state">正在加载项目看板…</view>
</view>
<view class="page" wx:elif="{{dashboard}}">
  <view class="card summary">
    <text class="tag">{{dashboard.project.code}}</text>
    <text class="title">{{dashboard.project.name}}</text>
    <text class="muted">身份：{{dashboard.member_name}} · 正式版本 v{{dashboard.current_version_number}}</text>
    <text class="plan">当前计划：{{dashboard.active_plan_name}}</text>
    <view class="card-action-row">
      <button class="card-action summary-action" size="mini" type="primary" bindtap="openProjectReview">查看项目资料</button>
    </view>
  </view>
  <view wx:for="{{proposals}}" wx:key="id" class="card milestone">
    <text class="tag approval-tag">{{item.is_own_submission && item.can_resolve ? "本人提交 · 可审批" : item.is_own_submission ? "本人提交 · 待他人审批" : "待我审批"}}</text>
    <text class="name">{{item.milestone_code}} · {{item.reason}}</text>
    <text class="muted proposal-time">提交时间：{{item.createdAtLabel}}</text>
    <view wx:if="{{item.can_resolve}}" class="proposal-actions">
      <button size="mini" type="primary" loading="{{resolvingProposalId === item.id}}" disabled="{{resolvingProposalId !== ''}}" data-id="{{item.id}}" data-version="{{item.base_version_number}}" bindtap="approveProposal">批准变更</button>
      <button size="mini" type="warn" loading="{{resolvingProposalId === item.id}}" disabled="{{resolvingProposalId !== ''}}" data-id="{{item.id}}" bindtap="rejectProposal">驳回</button>
    </view>
  </view>
  <view wx:for="{{issueCreateProposals}}" wx:key="id" class="card milestone">
    <text class="tag approval-tag">待审批新增问题</text>
    <text class="name">{{item.payload.description}}</text>
    <text class="muted">R {{item.payload.owner_name}} · A {{item.payload.accountable_names.join('、')}}</text>
    <text class="muted proposal-time">提交时间：{{item.createdAtLabel}}</text>
    <view class="proposal-actions">
      <button size="mini" type="primary" loading="{{resolvingIssueProposalId === item.id}}" disabled="{{resolvingIssueProposalId !== ''}}" data-id="{{item.id}}" data-action="approve" bindtap="resolveIssueCreateProposal">批准新增</button>
      <button size="mini" type="warn" loading="{{resolvingIssueProposalId === item.id}}" disabled="{{resolvingIssueProposalId !== ''}}" data-id="{{item.id}}" data-action="reject" bindtap="resolveIssueCreateProposal">驳回</button>
    </view>
  </view>
  <view wx:for="{{issueDeleteProposals}}" wx:key="id" class="card milestone">
    <text class="tag approval-tag">待审批删除问题</text>
    <text class="name">{{item.issue_description}}</text>
    <text class="muted">删除原因：{{item.reason}}</text>
    <text class="muted proposal-time">提交时间：{{item.createdAtLabel}}</text>
    <view class="proposal-actions">
      <button size="mini" type="warn" loading="{{resolvingIssueProposalId === item.id}}" disabled="{{resolvingIssueProposalId !== ''}}" data-id="{{item.id}}" data-action="approve" bindtap="resolveIssueDeleteProposal">批准删除</button>
      <button size="mini" loading="{{resolvingIssueProposalId === item.id}}" disabled="{{resolvingIssueProposalId !== ''}}" data-id="{{item.id}}" data-action="reject" bindtap="resolveIssueDeleteProposal">驳回</button>
    </view>
  </view>
  <view wx:if="{{dashboard.is_project_manager && issueCreateProposals.length === 0 && issueDeleteProposals.length === 0}}" class="approval-empty">暂无待审批的问题申请</view>
  <view class="milestone-filters">
    <button
      wx:for="{{primaryMilestoneFilters}}"
      wx:key="key"
      class="milestone-filter {{selectedMilestoneFilter === item.key ? 'active' : ''}} {{item.key === 'overdue' && item.count > 0 ? 'overdue' : ''}}"
      data-key="{{item.key}}"
      bindtap="selectMilestoneFilter"
    >{{item.label}} {{item.count}}</button>
    <button class="milestone-filter more {{selectedMilestoneFilter === 'completed' || selectedMilestoneFilter === 'all' ? 'active' : ''}}" bindtap="openMoreFilters">{{moreFilterLabel}}</button>
  </view>
  <view wx:if="{{visibleMilestones.length === 0}}" class="card empty-state">当前分类暂无节点</view>
  <view wx:for="{{visibleMilestones}}" wx:key="code" class="card milestone milestone-card">
    <view class="row">
      <text class="code">{{item.code}}</text>
      <text class="name">{{item.name}}</text>
      <text wx:if="{{item.statusLabel}}" class="done">{{item.statusLabel}}</text>
    </view>
    <text class="muted">计划：{{item.planLabel}}</text>
    <view wx:if="{{item.can_update}}" class="card-action-row">
      <button class="card-action milestone-action" size="mini" type="primary" data-code="{{item.code}}" bindtap="updateMilestone">更新进度</button>
    </view>
  </view>
</view>
<view class="page" wx:else>
  <view class="card error-state">
    <text class="error-title">项目看板加载失败</text>
    <text class="error-detail">请检查网络连接后重新加载。</text>
    <button class="retry-action" bindtap="loadDashboard">重新加载</button>
  </view>
</view>
