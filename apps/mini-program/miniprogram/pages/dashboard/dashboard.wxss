.summary .muted, .plan { display: block; margin-top: 10rpx; }
.row { display: flex; align-items: center; gap: 14rpx; margin-bottom: 14rpx; }
.code { color: #146c5a; font-weight: 700; }
.name { flex: 1; font-weight: 650; }
.done { color: #146c5a; font-size: 22rpx; }
.approval-tag { color: #b54708; background: #fff1e6; }
.approval-empty { margin-bottom: 18rpx; color: #6f7b78; font-size: 24rpx; text-align: center; }
.approval-card { cursor: pointer; }
.approval-card .name { display: block; }
.approval-raci { display: flex; flex-wrap: wrap; gap: 8rpx 18rpx; margin-top: 10rpx; color: #53635f; font-size: 22rpx; }
.proposal-time { display: block; margin-top: 10rpx; }
.card-action-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
}
.card-action {
  margin: 0;
}
.dashboard-action {
  min-width: 152rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 10rpx;
  font-weight: 650;
  line-height: 64rpx;
}
.dashboard-action::after { border: 0; }
.dashboard-action-primary { background: #146c5a; color: #fff; }
.dashboard-action-secondary { border: 1rpx solid #146c5a; background: #fff; color: #146c5a; }
.milestone-card .muted { display: block; }
.focused-milestone { border: 2rpx solid #20a486; box-shadow: 0 0 0 5rpx rgba(32, 164, 134, .12); }
.proposal-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 14rpx; }
.proposal-actions button { margin: 0; }
.milestone-filters { display: flex; width: 100%; gap: 10rpx; margin-bottom: 20rpx; }
.milestone-filter {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  box-sizing: border-box;
  margin: 0;
  padding: 0 8rpx;
  border: 1rpx solid #c9ddd8;
  border-radius: 30rpx;
  background: #fff;
  color: #53635f;
  font-size: 24rpx;
  line-height: 56rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.milestone-filter::after { border: 0; }
.milestone-filter.active { background: #146c5a; color: #fff; }
.milestone-filter.upcoming { border-color: #f7cda7; color: #b54708; background: #fff8f1; }
.milestone-filter.overdue { border-color: #f5b9b6; color: #c53030; background: #fff5f5; }
.milestone-filter.upcoming.active,
.milestone-filter.overdue.active { color: #fff; background: #c53030; }
.milestone-filter.upcoming.active { background: #146c5a; }
.milestone-filter.more { flex-grow: 1.3; font-size: 21rpx; }
.empty-state { color: #6f7b78; text-align: center; }
