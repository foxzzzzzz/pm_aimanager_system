.summary .muted, .plan { display: block; margin-top: 10rpx; }
.row { display: flex; align-items: center; gap: 14rpx; margin-bottom: 14rpx; }
.code { color: #146c5a; font-weight: 700; }
.name { flex: 1; font-weight: 650; }
.done { color: #146c5a; font-size: 22rpx; }
.card-action-row {
  display: flex;
  justify-content: flex-end;
}
.card-action {
  display: flex;
  width: auto;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
  margin: 18rpx 0 0;
  margin-left: auto;
  padding: 0 26rpx;
  border: 0;
  border-radius: 999rpx;
  color: #fff;
  background: #146c5a;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 58rpx;
  text-align: center;
}
.card-action::after { border: 0; }
.action-arrow { color: rgba(255, 255, 255, 0.78); font-size: 28rpx; font-weight: 400; }
.milestone-card .muted { display: block; }
.proposal-actions { display: flex; gap: 16rpx; }
.proposal-actions button { margin-right: 0; }
.milestone-filters { width: 100%; margin-bottom: 20rpx; white-space: nowrap; }
.milestone-filter-list { display: inline-flex; gap: 12rpx; padding: 2rpx; }
.milestone-filter {
  min-width: auto;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid #c9ddd8;
  border-radius: 30rpx;
  background: #fff;
  color: #53635f;
  font-size: 24rpx;
  line-height: 56rpx;
}
.milestone-filter::after { border: 0; }
.milestone-filter.active { background: #146c5a; color: #fff; }
.empty-state { color: #6f7b78; text-align: center; }
