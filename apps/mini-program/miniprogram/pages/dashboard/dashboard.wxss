.summary .muted, .plan { display: block; margin-top: 10rpx; }
.row { display: flex; align-items: center; gap: 14rpx; margin-bottom: 14rpx; }
.code { color: #146c5a; font-weight: 700; }
.name { flex: 1; font-weight: 650; }
.done { color: #146c5a; font-size: 22rpx; }
.approval-tag { color: #b54708; background: #fff1e6; }
.card-action-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
}
.card-action {
  margin: 0;
}
.milestone-card .muted { display: block; }
.proposal-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 14rpx; }
.proposal-actions button { margin: 0; }
.milestone-filters { display: flex; width: 100%; gap: 10rpx; margin-bottom: 20rpx; }
.milestone-filter {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  box-sizing: border-box;
  margin: 0;
  padding: 0 8rpx;
  border: 1rpx solid #c9ddd8;
  border-radius: 30rpx;
  background: #fff;
  color: #53635f;
  font-size: 24rpx;
  line-height: 56rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.milestone-filter::after { border: 0; }
.milestone-filter.active { background: #146c5a; color: #fff; }
.milestone-filter.overdue { border-color: #f5b9b6; color: #c53030; background: #fff5f5; }
.milestone-filter.overdue.active { color: #fff; background: #c53030; }
.milestone-filter.more { flex-grow: 1.3; font-size: 21rpx; }
.empty-state { color: #6f7b78; text-align: center; }
