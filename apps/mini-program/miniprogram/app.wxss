page {
  min-height: 100%;
  color: #17322d;
  background: #edf4f1;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #d7e6e1;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(23, 50, 45, 0.05);
}

.title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.muted {
  color: #63716d;
  font-size: 26rpx;
}

.primary {
  margin-top: 24rpx;
  border-radius: 14rpx;
  color: #ffffff;
  background: #146c5a;
  font-weight: 600;
}

.field {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #c9ddd6;
  border-radius: 14rpx;
  background: #f8fbfa;
}

.tag {
  display: inline-block;
  margin-right: 12rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #146c5a;
  background: #dff2ec;
  font-size: 22rpx;
}

.loading-state,
.empty-state {
  padding: 48rpx 30rpx;
  color: #63716d;
  text-align: center;
}

button.primary::after {
  border: 0;
}
