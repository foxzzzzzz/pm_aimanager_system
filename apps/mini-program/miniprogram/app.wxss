page {
  min-height: 100%;
  color: #17322d;
  background: #edf4f1;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  padding: 28rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border: 1rpx solid #d7e6e1;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(23, 50, 45, 0.07);
}

.title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.muted {
  color: #63716d;
  font-size: 26rpx;
}

.primary {
  margin-top: 24rpx;
  color: #ffffff;
  background: #146c5a;
}

.field {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #c9ddd6;
  border-radius: 14rpx;
  background: #f8fbfa;
}

.tag {
  display: inline-block;
  margin-right: 12rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #146c5a;
  background: #dff2ec;
  font-size: 22rpx;
}
