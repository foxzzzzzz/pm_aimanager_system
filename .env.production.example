# Public HTTPS names. Point both A records to this server before deployment.
API_PUBLIC_DOMAIN=api.example.com
ADMIN_PUBLIC_DOMAIN=admin.example.com
# Email used by Caddy for Let's Encrypt expiry and recovery notifications.
TLS_EMAIL=ops@example.com

# Docker service data credentials. Replace the placeholder passwords before deployment.
POSTGRES_DB=project_manager
POSTGRES_USER=project_manager
POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=project-manager
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password

# Keep application service ports inaccessible from the public network.
POSTGRES_HOST_PORT=127.0.0.1:15432
REDIS_HOST_PORT=127.0.0.1:16379
MINIO_API_HOST_PORT=127.0.0.1:19000
MINIO_CONSOLE_HOST_PORT=127.0.0.1:19001
API_HOST_PORT=127.0.0.1:18000
ADMIN_WEB_HOST_PORT=127.0.0.1:15173
ADMIN_WEB_API_BASE_URL=https://api.example.com/api/v1

# Build dependency mirrors. Keep defaults unless your server needs a mirror.
PYPI_INDEX_URL=https://pypi.org/simple
PIP_DEFAULT_TIMEOUT=60
NPM_REGISTRY=https://registry.npmjs.org
APP_CONFIG_PATH=/app/config/app.example.yaml

# Generated by scripts/init-production.sh; never commit the generated .env.production.
ADMIN_API_TOKEN=
PHONE_HMAC_KEY=
PHONE_ENCRYPTION_KEY=

# Production WeChat configuration.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_INVITATION_DAYS=7
WECHAT_ALLOW_INVITATION_ONLY_BINDING=false
WECHAT_INVITATION_PAGE=pages/index/index
WECHAT_INVITATION_ENV_VERSION=release
WECHAT_INVITATION_CODE_WIDTH=430
WECHAT_SUBSCRIPTION_TEMPLATE_ID=
WECHAT_SUBSCRIPTION_TITLE_FIELD=thing1
WECHAT_SUBSCRIPTION_BODY_FIELD=thing2
WECHAT_SUBSCRIPTION_FIELD_MAX_LENGTH=20
PROJECT_MANAGER_CORS_ORIGINS=https://admin.example.com
PROJECT_MANAGER_ALLOW_DEV_WECHAT_LOGIN=false

# Tencent Cloud SMS fallback. Leave disabled until all credentials and the approved template are entered.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_CRITICAL_TEMPLATE_ID=
PROJECT_MANAGER_SMS_ENABLED=false
