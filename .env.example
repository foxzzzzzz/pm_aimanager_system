# Docker Compose development credentials. Replace all values outside local development.
POSTGRES_DB=project_manager
POSTGRES_USER=project_manager
POSTGRES_PASSWORD=change-me
# Host-side Alembic connection; Docker injects the equivalent internal hostname into the API.
PROJECT_MANAGER_DATABASE_URL=postgresql+psycopg://project_manager:change-me@localhost:15432/project_manager
MINIO_ROOT_USER=project-manager
MINIO_ROOT_PASSWORD=change-me-now

# Host ports can be changed when another local service already uses the default.
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
API_HOST_PORT=18000
ADMIN_WEB_HOST_PORT=15173

# Public dependency indexes used only during Docker image builds.
PYPI_INDEX_URL=https://pypi.org/simple
PIP_DEFAULT_TIMEOUT=60
NPM_REGISTRY=https://registry.npmjs.org

# Application configuration file mounted into the API container.
APP_CONFIG_PATH=/app/config/app.example.yaml

# Secrets are injected at runtime and are never stored in app.example.yaml.
ADMIN_API_TOKEN=replace-with-a-long-random-token
PHONE_HMAC_KEY=replace-with-a-long-random-key
LLM_API_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Local Docker acceptance only. Set false outside development.
PROJECT_MANAGER_ALLOW_DEV_WECHAT_LOGIN=true
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
